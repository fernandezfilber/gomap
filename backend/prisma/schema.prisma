generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// --- 1. GESTIÓN DE ACCESO Y PERSONAL ---

model Usuario {
  id               String   @id @default(uuid())
  nombre           String
  email            String   @unique
  password         String
  rol              Rol      @default(TECNICO)
  activo           Boolean  @default(true)
  creadoEn         DateTime @default(now())

  // Relación con averías que el técnico debe reparar
  averiasAsignadas Averia[]
}

enum Rol {
  ADMIN   // Puede gestionar infraestructura y usuarios
  TECNICO // Solo puede ver mapa, factibilidad y atender averías
}

// --- 2. INFRAESTRUCTURA DE RED (JERARQUÍA TÉCNICA) ---

model Troncal {
  id          String   @id @default(uuid())
  nombre      String   @unique
  prefijo     String   @unique
  capacidad   Int      @default(96)
  descripcion String?
  
  // Ruta principal por las calles (Polyline)
  ruta        Json?    // [{lat: -11.1, lng: -76.1}, ...]
  
  creadoEn    DateTime @default(now())
  mufas       Mufa[]
}

model Mufa {
  id             String       @id @default(uuid())
  codigo         String       @unique 
  bufferColor    String   
  bufferPrefijo  String   
  hiloColor      String   
  latitud        Float
  longitud       Float
  direccion      String?
  capacidadHilos Int          @default(16)
  ratioSplitteo  String?      @default("1:16")

  ruta           Json?        // Camino desde la Troncal hasta la Mufa
  detalles       String?      @db.Text
  estadoFisico   String?      @default("BUENO")
  creadoEn       DateTime     @default(now())

  // --- RELACIONES ---
  // Una sola definición de troncal con Cascade para borrado seguro
  troncalId      String
  troncal        Troncal      @relation(fields: [troncalId], references: [id], onDelete: Cascade)
  
  // Relación con Poste
  posteId        String?   
  poste          Poste?       @relation(fields: [posteId], references: [id])

  // Equipos dependientes
  cajas          Caja[]

  // Relación inversa para cables
  tramosSalida   TramoCable[] @relation("CableDesdeMufa")
}

model Caja {
  id             String    @id @default(uuid())
  codigo         String    @unique
  puertoMufa     Int       
  puertoOlt      String?   
  latitud        Float
  longitud       Float
  colorFibraCaja String?   
  puertosTotales Int       @default(16)

  ruta           Json?     // Camino desde la Mufa hasta la Caja
  detalles       String?   @db.Text
  observaciones  String?   

  mufaId         String
  mufa           Mufa      @relation(fields: [mufaId], references: [id], onDelete: Cascade)
  
  clientes       Cliente[]
  creadoEn       DateTime  @default(now())
  
  // Relación con Poste
  posteId        String?   
  poste          Poste?    @relation(fields: [posteId], references: [id])

  // 🛰️ RELACIÓN INVERSA PARA TRAMOCABLE (Lo que faltaba)
  tramosEntrada  TramoCable[] @relation("CableHaciaCaja")
}

// --- 3. CLIENTES Y OPERACIONES ---

model Cliente {
  id              String   @id @default(uuid())
  nombre          String
  dni             String   @unique
  telefono        String
  direccion       String?
  
  onuExternalId   String?  @unique 
  snMac           String?  @unique
  
  latitud         Float?
  longitud        Float?
  estadoServicio  String   @default("ACTIVO")
  
  cajaId          String
  caja            Caja     @relation(fields: [cajaId], references: [id])
  
  averias         Averia[]
  pagos           Pago[]
  creadoEn        DateTime @default(now())
}

model Averia {
  id              String   @id @default(uuid())
  tipo            TipoAveria @default(SIN_INTERNET)
  descripcion     String   @db.Text
  estado          EstadoAveria @default(PENDIENTE)
  prioridad       String   @default("MEDIA")
  
  clienteId       String
  cliente         Cliente  @relation(fields: [clienteId], references: [id])
  
  tecnicoId       String?
  tecnico         Usuario? @relation(fields: [tecnicoId], references: [id])
  
  creadoEn        DateTime @default(now())
}

model Pago {
  id              String   @id @default(uuid())
  monto           Float
  metodo          Metodo     @default(YAPE)
  estado          EstadoPago @default(PENDIENTE)
  referencia      String?    @unique // Número de operación
  fechaPago       DateTime   @default(now())

  clienteId       String
  cliente         Cliente    @relation(fields: [clienteId], references: [id])
}

// --- 4. INFRAESTRUCTURA FÍSICA ---

model Poste {
  id          String   @id @default(uuid())
  codigo      String   @unique
  latitud     Float
  longitud    Float
  tipo        String   @default("CONCRETO")
  altura      String?  
  propietario String? 

  mufas       Mufa[]
  cajas       Caja[]
  
  creadoEn    DateTime @default(now())
}

model TramoCable {
  id            String  @id @default(uuid())
  nombre        String? 
  tipoCable     String  // ADSS, Drop, etc.
  metraje       Float?  
  
  // Geometría de la línea
  path          Json    // [{lat:..., lng:...}]

  creadoEn      DateTime @default(now())

  // Relaciones con Mufa y Caja
  mufaOrigenId  String?
  mufaOrigen    Mufa?    @relation("CableDesdeMufa", fields: [mufaOrigenId], references: [id])
  
  cajaDestinoId String?
  cajaDestino   Caja?    @relation("CableHaciaCaja", fields: [cajaDestinoId], references: [id])
}

// --- 5. ENUMS ---

enum Metodo {
  YAPE
  PLIN
  TRANSFERENCIA
  EFECTIVO
}

enum EstadoPago {
  PENDIENTE
  APROBADO
  RECHAZADO
}

enum EstadoAveria {
  PENDIENTE
  EN_REPARACION
  SOLUCIONADO
}

enum TipoAveria {
  SIN_INTERNET
  LENTITUD
  CABLE_ROTO
  CAJA_NAP_DANADA
}