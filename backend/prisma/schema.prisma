// --- CONFIGURACIÓN ---
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
 provider = "prisma-client-js"
 binaryTargets = ["native", "debian-openssl-3.0.x"]
}

// --- 1. GESTIÓN DE PROYECTOS Y ACCESO ---

model Proyecto {
  id          String       @id @default(uuid())
  nombre      String       // Ej: "Despliegue Jicamarca Sector 3"
  descripcion String?
  estado      String       @default("PLANIFICACION") // PLANIFICACION, EN_EJECUCION, FINALIZADO
  creadoEn    DateTime     @default(now())

  // Relaciones
  tramos      TramoCable[]
  troncales   Troncal[]
}

model Usuario {
  id               String   @id @default(uuid())
  nombre           String
  email            String   @unique
  password         String
  rol              Rol      @default(TECNICO)
  activo           Boolean  @default(true)
  creadoEn         DateTime @default(now())
  averiasAsignadas Averia[]
}

enum Rol {
  ADMIN
  TECNICO
}

// --- 2. INFRAESTRUCTURA DE RED (JERARQUÍA TÉCNICA) ---

model Troncal {
  id            String   @id @default(uuid())
  nombre        String   @unique
  bufferColor   String   // Color del Buffer principal
  cantHilos     Int      @default(96)
  hilosLibres   Int      // Contador dinámico
  descripcion   String?
  ruta          Json?    // [{lat, lng}, ...]

  proyectoId    String
  proyecto      Proyecto @relation(fields: [proyectoId], references: [id])
  
  mufas         Mufa[]
  creadoEn      DateTime @default(now())
}

model Mufa {
  id             String   @id @default(uuid())
  codigo         String   @unique
  latitud        Float
  longitud       Float
  
  // Trazabilidad de Fibra
  bufferEntrada  String   // Color del buffer que entra
  hiloEntrada    Int      // Número/Color del hilo que se "sangra"
  ratioSplitteo  String   @default("1:16")
  hilosDisponibles Int    @default(16) // Hilos después del splitter

  // Relaciones Obligatorias
  troncalId      String
  troncal        Troncal  @relation(fields: [troncalId], references: [id], onDelete: Cascade)
  
  posteId        String
  poste          Poste    @relation(fields: [posteId], references: [id])

  cajas          Caja[]
  tramosOrigen   TramoCable[] @relation("CableDesdeMufa")
  creadoEn       DateTime @default(now())
}

model Caja {
  id             String   @id @default(uuid())
  codigo         String   @unique
  latitud        Float
  longitud       Float
  colorHiloCaja  String?  // Color del hilo que alimenta esta caja desde la mufa
  puertosLibres  Int      @default(16)

  mufaId         String
  mufa           Mufa     @relation(fields: [mufaId], references: [id], onDelete: Cascade)
  
  posteId        String
  poste          Poste    @relation(fields: [posteId], references: [id])

  clientes       Cliente[]
  tramosDestino  TramoCable[] @relation("CableHaciaCaja")
  creadoEn       DateTime @default(now())
}

// --- 3. INFRAESTRUCTURA FÍSICA Y CABLEADO ---

model Poste {
  id          String   @id @default(uuid())
  codigo      String   @unique
  latitud     Float
  longitud    Float
  tipo        String   @default("CONCRETO") // MADERA, FIERRO
  altura      String?
  
  mufas       Mufa[]
  cajas       Caja[]
  tramosInicio TramoCable[] @relation("InicioPoste")
  tramosFin    TramoCable[] @relation("FinPoste")
  
  creadoEn    DateTime @default(now())
}

model TramoCable {
  id            String   @id @default(uuid())
  nombre        String?
  tipoCable     String   // ADSS, DROP
  path          Json     // [{lat, lng}, ...]
  colorVisual   String   @default("#8b5cf6")

  proyectoId    String
  proyecto      Proyecto @relation(fields: [proyectoId], references: [id])

  // Puntos de anclaje (Obligatorios para no iniciar de la nada)
  posteInicioId String
  posteInicio   Poste    @relation("InicioPoste", fields: [posteInicioId], references: [id])
  
  posteFinId    String
  posteFin      Poste    @relation("FinPoste", fields: [posteFinId], references: [id])

  // Relaciones lógicas opcionales
  mufaOrigenId  String?
  mufaOrigen    Mufa?    @relation("CableDesdeMufa", fields: [mufaOrigenId], references: [id])
  
  cajaDestinoId String?
  cajaDestino   Caja?    @relation("CableHaciaCaja", fields: [cajaDestinoId], references: [id])
}

// --- 4. OPERACIONES (CLIENTES, PAGOS, AVERIAS) ---
// (Se mantienen igual, vinculados a Caja)
model Cliente {
  id      String @id @default(uuid())
  nombre  String
  dni     String @unique
  cajaId  String
  caja    Caja   @relation(fields: [cajaId], references: [id])
  averias Averia[]
  pagos   Pago[]
}

model Averia {
  id        String   @id @default(uuid())
  clienteId String
  cliente   Cliente  @relation(fields: [clienteId], references: [id])
  tecnicoId String?
  tecnico   Usuario? @relation(fields: [tecnicoId], references: [id])
}

model Pago {
  id        String @id @default(uuid())
  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id])
}