generator client {
  provider      = "prisma-client-js"
  // Esto le dice a Prisma que prepare motores para tu PC (native) 
  // y para los servidores de Hostinger (debian)
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}
// ====================== EMPRESA (Tenant) ======================
model Empresa {
  id          String   @id @default(uuid())
  nombre      String
  razonSocial String?
  ruc         String?  @unique
  telefono    String?
  direccion   String?
  activo      Boolean  @default(true)
  creadoEn    DateTime @default(now())

  usuarios  Usuario[]
  proyectos Proyecto[]

  @@map("empresas")
}

// ====================== USUARIO ======================
model Usuario {
  id        String  @id @default(uuid())
  nombre    String
  email     String  @unique
  password  String
  rol       Rol     @default(TECNICO)
  activo    Boolean @default(true)
  empresaId String

  creadoEn    DateTime  @default(now())
  ultimoLogin DateTime?

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@index([empresaId])
  @@map("usuarios")
}

enum Rol {
  ADMIN
  TECNICO
  VIEWER
}

// ====================== PROYECTO ======================
model Proyecto {
  id          String   @id @default(uuid())
  nombre      String
  descripcion String?
  estado      String   @default("PLANIFICACION")
  creadoEn    DateTime @default(now())

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  troncales Troncal[]
  tramos    TramoCable[]

  @@index([empresaId])
  @@map("proyectos")
}

// ====================== POSTE ======================
model Poste {
  id       String   @id @default(uuid())
  codigo   String   @unique
  latitud  Float
  longitud Float
  tipo     String   @default("CONCRETO")
  altura   String?
  creadoEn DateTime @default(now())

  // Relaciones
  mufa         Mufa?        @relation("PosteMufa")
  caja         Caja?        @relation("PosteCaja")
  tramosInicio TramoCable[] @relation("InicioPoste")
  tramosFin    TramoCable[] @relation("FinPoste")

  @@map("postes")
}

// ====================== TRONCAL ======================
model Troncal {
  id          String  @id @default(uuid())
  nombre      String  @unique
  bufferColor String
  cantHilos   Int     @default(96)
  hilosLibres Int
  descripcion String?
  ruta        String? @db.LongText
  proyectoId  String

  proyecto Proyecto @relation(fields: [proyectoId], references: [id])
  mufas    Mufa[]

  creadoEn DateTime @default(now())

  @@index([proyectoId])
  @@map("troncales")
}

// ====================== MUFA ======================
model Mufa {
  id               String @id @default(uuid())
  codigo           String @unique
  latitud          Float
  longitud         Float
  bufferEntrada    String
  hiloEntrada      Int
  ratioSplitteo    String @default("1:16")
  hilosDisponibles Int    @default(16)

  posteId   String @unique
  troncalId String

  poste        Poste        @relation("PosteMufa", fields: [posteId], references: [id])
  troncal      Troncal      @relation(fields: [troncalId], references: [id], onDelete: Cascade)
  tramosOrigen TramoCable[] @relation("CableDesdeMufa")

  creadoEn DateTime @default(now())
  cajas    Caja[]

  @@index([troncalId])
  @@map("mufas")
}

// ====================== CAJA ======================
model Caja {
  id            String  @id @default(uuid())
  codigo        String  @unique
  latitud       Float
  longitud      Float
  colorHiloCaja String?
  puertosLibres Int     @default(16)

  posteId String  @unique
  mufaId  String?

  poste Poste @relation("PosteCaja", fields: [posteId], references: [id])
  mufa  Mufa? @relation(fields: [mufaId], references: [id], onDelete: Cascade)

  clientes      Cliente[]
  tramosDestino TramoCable[] @relation("CableHaciaCaja")

  creadoEn DateTime @default(now())

  @@map("cajas")
}

// ====================== TRAMO CABLE ======================
model TramoCable {
  id          String  @id @default(uuid())
  nombre      String?
  tipoCable   String
  path        String  @db.LongText
  colorVisual String  @default("#8b5cf6")

  proyectoId    String
  posteInicioId String
  posteFinId    String
  mufaOrigenId  String?
  cajaDestinoId String?

  proyecto    Proyecto @relation(fields: [proyectoId], references: [id])
  posteInicio Poste    @relation("InicioPoste", fields: [posteInicioId], references: [id])
  posteFin    Poste    @relation("FinPoste", fields: [posteFinId], references: [id])
  mufaOrigen  Mufa?    @relation("CableDesdeMufa", fields: [mufaOrigenId], references: [id])
  cajaDestino Caja?    @relation("CableHaciaCaja", fields: [cajaDestinoId], references: [id])

  creadoEn DateTime @default(now())

  @@index([proyectoId])
  @@index([posteInicioId])
  @@index([posteFinId])
  @@map("tramo_cables")
}

// ====================== CLIENTE ======================
model Cliente {
  id             String  @id @default(uuid())
  nombre         String
  dni            String  @unique
  telefono       String?
  direccion      String?
  snMac          String?
  latitud        Float?
  longitud       Float?
  estadoServicio String  @default("ACTIVO")

  cajaId String
  caja   Caja   @relation(fields: [cajaId], references: [id])

  creadoEn DateTime @default(now())

  @@map("clientes")
}
