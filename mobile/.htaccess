<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Si el archivo o carpeta existe, úsala (imágenes, js, css)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  
  # Si no existe, manda todo al index.html
  RewriteRule ^ index.html [L]
</IfModule>